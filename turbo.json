{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "outputs": ["dist/**"]
    },
    "watch:dev": {
      "cache": false,
      "persistent": true
    },
    "build:page": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
